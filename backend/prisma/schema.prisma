generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["slokasetu"]
}

enum CategoryType {
  OCCASION
  SLOKA
  BOTH

  @@schema("slokasetu")
}

enum VerificationStatus {
  DRAFT
  UNDER_REVIEW
  VERIFIED
  PUBLISHED
  ARCHIVED

  @@schema("slokasetu")
}

enum VersionType {
  ORIGINAL_TEXT
  TRANSLITERATION
  TRANSLATION
  COMMENTARY

  @@schema("slokasetu")
}

enum RelationshipType {
  OFFICIAL_PROGRAMME
  TRADITIONAL
  CURATED_RECOMMENDATION
  RITUAL_REQUIRED

  @@schema("slokasetu")
}

enum AliasType {
  TRANSLITERATION
  PHONETIC
  REGIONAL
  ABBREVIATION

  @@schema("slokasetu")
}

enum EntityType {
  SLOKA
  VERSION
  OCCASION
  RESOURCE

  @@schema("slokasetu")
}

enum UserRole {
  ADMIN
  REVIEWER
  VIEWER

  @@schema("slokasetu")
}

model Institution {
  id         String     @id @default(uuid())
  name       String
  code       String     @unique
  campus     String
  department String
  city       String
  state      String
  country    String     @default("India")
  occasions  Occasion[]

  @@map("institutions")
  @@schema("slokasetu")
}

model Category {
  id          String       @id @default(uuid())
  name        String       @unique
  slug        String       @unique
  description String?
  type        CategoryType @default(BOTH)
  occasions   Occasion[]
  slokas      Sloka[]

  @@map("categories")
  @@schema("slokasetu")
}

model Deity {
  id           String        @id @default(uuid())
  name         String        @unique
  slug         String        @unique
  description  String?
  iconName     String?
  occasions    Occasion[]
  slokas       Sloka[]
  slokaDeities SlokaDeity[]

  @@map("deities")
  @@schema("slokasetu")
}

model Occasion {
  id               String            @id @default(uuid())
  slug             String            @unique
  name             String
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id])
  institutionId    String?
  institution      Institution?      @relation(fields: [institutionId], references: [id])
  deityId          String?
  deity            Deity?            @relation(fields: [deityId], references: [id])
  description      String            @db.Text
  significance     String?           @db.Text
  whatHappensToday String?           @db.Text
  preparationGuide String?           @db.Text
  primarySourceId  String?
  primarySource    Source?           @relation(fields: [primarySourceId], references: [id])
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  dates            OccasionDate[]
  occasionSlokas   OccasionSloka[]
  pdfResources     PdfResource[]

  @@index([categoryId])
  @@index([deityId])
  @@index([institutionId])
  @@map("occasions")
  @@schema("slokasetu")
}

model OccasionDate {
  id                 String             @id @default(uuid())
  occasionId         String
  occasion           Occasion           @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  gregorianDate      DateTime
  year               Int
  region             String?            @default("All India")
  calendarConvention String             @default("Drik Ganita / Purnimanta")
  verificationStatus VerificationStatus @default(VERIFIED)
  sourceReference    String?

  @@index([gregorianDate])
  @@index([year])
  @@index([occasionId])
  @@map("occasion_dates")
  @@schema("slokasetu")
}

model Sloka {
  id                 String             @id @default(uuid())
  slug               String             @unique
  canonicalTitle     String
  categoryId         String
  category           Category           @relation(fields: [categoryId], references: [id])
  deityId            String?
  deity              Deity?             @relation(fields: [deityId], references: [id])
  backgroundContext  String?            @db.Text
  historicalNotes    String?            @db.Text
  traditionalNotes   String?            @db.Text
  significanceNotes  String?            @db.Text
  isPublished        Boolean            @default(true)
  verificationStatus VerificationStatus @default(VERIFIED)
  primarySourceId    String?
  primarySource      Source?            @relation(fields: [primarySourceId], references: [id])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  aliases            SlokaAlias[]
  versions           SlokaVersion[]
  slokaDeities       SlokaDeity[]
  occasionSlokas     OccasionSloka[]
  pdfResources       PdfResource[]

  @@index([canonicalTitle])
  @@index([categoryId])
  @@index([deityId])
  @@index([isPublished])
  @@map("slokas")
  @@schema("slokasetu")
}

model SlokaAlias {
  id         String    @id @default(uuid())
  slokaId    String
  sloka      Sloka     @relation(fields: [slokaId], references: [id], onDelete: Cascade)
  aliasTitle String
  scriptId   String?
  script     Script?   @relation(fields: [scriptId], references: [id])
  aliasType  AliasType @default(TRANSLITERATION)

  @@index([slokaId])
  @@index([aliasTitle])
  @@map("sloka_aliases")
  @@schema("slokasetu")
}

model Language {
  id          String         @id @default(uuid())
  code        String         @unique
  name        String
  nativeName  String
  isClassical Boolean        @default(false)
  versions    SlokaVersion[]

  @@map("languages")
  @@schema("slokasetu")
}

model Script {
  id         String         @id @default(uuid())
  code       String         @unique
  name       String
  nativeName String
  direction  String         @default("ltr")
  versions   SlokaVersion[]
  aliases    SlokaAlias[]

  @@map("scripts")
  @@schema("slokasetu")
}

model SlokaVersion {
  id                 String             @id @default(uuid())
  slokaId            String
  sloka              Sloka              @relation(fields: [slokaId], references: [id], onDelete: Cascade)
  languageId         String
  language           Language           @relation(fields: [languageId], references: [id])
  scriptId           String
  script             Script             @relation(fields: [scriptId], references: [id])
  versionType        VersionType        @default(ORIGINAL_TEXT)
  textContent        String             @db.Text
  verseData          Json?
  sourceId           String?
  source             Source?            @relation(fields: [sourceId], references: [id])
  pageStart          Int?
  pageEnd            Int?
  verificationStatus VerificationStatus @default(VERIFIED)
  confidenceScore    Float              @default(1.0)
  isPublished        Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  pdfResources       PdfResource[]

  @@index([slokaId])
  @@index([languageId])
  @@index([scriptId])
  @@index([isPublished])
  @@map("sloka_versions")
  @@schema("slokasetu")
}

model SlokaDeity {
  slokaId   String
  sloka     Sloka   @relation(fields: [slokaId], references: [id], onDelete: Cascade)
  deityId   String
  deity     Deity   @relation(fields: [deityId], references: [id], onDelete: Cascade)
  isPrimary Boolean @default(false)

  @@id([slokaId, deityId])
  @@map("sloka_deities")
  @@schema("slokasetu")
}

model OccasionSloka {
  id               String           @id @default(uuid())
  occasionId       String
  occasion         Occasion         @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  slokaId          String
  sloka            Sloka            @relation(fields: [slokaId], references: [id], onDelete: Cascade)
  relationshipType RelationshipType @default(TRADITIONAL)
  displayOrder     Int              @default(1)
  notes            String?
  isVerified       Boolean          @default(true)

  @@unique([occasionId, slokaId])
  @@index([occasionId])
  @@index([slokaId])
  @@map("occasion_slokas")
  @@schema("slokasetu")
}

model Source {
  id                 String             @id @default(uuid())
  title              String
  authorPublisher    String?
  fileName           String             @unique
  storagePath        String
  fileSize           Int                @default(0)
  mimeType           String             @default("application/pdf")
  edition            String?
  sourceUrl          String?
  licenseInfo        String             @default("Academic / Devotional Use")
  verificationStatus VerificationStatus @default(VERIFIED)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  slokaVersions      SlokaVersion[]
  pdfResources       PdfResource[]
  primaryOccasions   Occasion[]
  primarySlokas      Sloka[]

  @@map("sources")
  @@schema("slokasetu")
}

model PdfResource {
  id                 String             @id @default(uuid())
  title              String
  slokaId            String?
  sloka              Sloka?             @relation(fields: [slokaId], references: [id], onDelete: SetNull)
  slokaVersionId     String?
  slokaVersion       SlokaVersion?      @relation(fields: [slokaVersionId], references: [id], onDelete: SetNull)
  occasionId         String?
  occasion           Occasion?          @relation(fields: [occasionId], references: [id], onDelete: SetNull)
  sourceId           String?
  source             Source?            @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  fileName           String
  filePath           String
  fileSize           Int
  mimeType           String             @default("application/pdf")
  pageReference      String?
  licenseType        String             @default("Educational Devotional Archive")
  verificationStatus VerificationStatus @default(VERIFIED)
  isPublic           Boolean            @default(true)
  downloadCount      Int                @default(0)
  createdAt          DateTime           @default(now())

  @@index([slokaId])
  @@index([occasionId])
  @@index([isPublic])
  @@map("pdf_resources")
  @@schema("slokasetu")
}

model ContentReview {
  id           String             @id @default(uuid())
  entityType   EntityType
  entityId     String
  reviewerName String
  reviewStatus VerificationStatus
  reviewNotes  String?            @db.Text
  reviewedAt   DateTime           @default(now())

  @@index([entityType, entityId])
  @@map("content_reviews")
  @@schema("slokasetu")
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String     @unique
  passwordHash String
  role         UserRole   @default(VIEWER)
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]

  @@map("users")
  @@schema("slokasetu")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
  @@schema("slokasetu")
}
