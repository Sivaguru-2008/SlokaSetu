# ===================================================================
# SLOKASETU ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ===================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL with custom schema)
DATABASE_URL=postgresql://<username>:<password>@localhost:5432/agents_runtime?schema=slokasetu

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# PDF Resource Storage
STORAGE_DIR=backend/storage/pdfs

# Frontend CORS Origin
CORS_ORIGIN=http://localhost:5173
